# GigaChat — публичный SDK (langchain-gigachat).
# Authorization key — Base64("Client ID:Client Secret") из личного кабинета GigaChat API.
GIGACHAT_CREDENTIALS=<client_id>:<client_secret>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=false

# OpenRouter — альтернативный провайдер (переключатель в UI). На внутреннем хостинге без
# доступа в интернет не будет работать — используйте только GigaChat. Ключ и base_url —
# как в smartmove-copilot/.env.local.
OPENROUTER_API_KEY=<sk-or-v1-...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
